function apiHealth_(){const ss=getDatabase_();return{success:true,app:APP_NAME,status:'connected',database:'Google Sheets',spreadsheetId:ss.getId(),spreadsheetUrl:ss.getUrl(),timestamp:new Date().toISOString()};}
function getBrands_(){return{success:true,brands:readSheetObjects_('Brands').filter(x=>String(x.active).toLowerCase()==='true'||x.active===true)};}
function getProducts_(p){p=p||{};let a=readSheetObjects_('Products').filter(x=>String(x.active).toLowerCase()==='true'||x.active===true);if(p.brandId)a=a.filter(x=>String(x.brandId).toLowerCase()===String(p.brandId).toLowerCase());if(p.brand)a=a.filter(x=>String(x.brandName).toLowerCase()===String(p.brand).toLowerCase());if(p.search){const q=String(p.search).toLowerCase();a=a.filter(x=>[x.name,x.model,x.sku,x.brandName].some(v=>String(v).toLowerCase().indexOf(q)>=0));}return{success:true,products:a};}
function getProduct_(p){p=p||{};const x=readSheetObjects_('Products').find(r=>String(r.productId)===String(p.productId)||String(r.sku).toLowerCase()===String(p.sku||'').toLowerCase());return x?{success:true,product:x}:{success:false,error:'Product not found.'};}
function searchCustomers_(p){p=p||{};let a=readSheetObjects_('Customers');if(p.mobile){const m=normalizeMobile_(p.mobile);a=a.filter(x=>normalizeMobile_(x.mobile)===m);}if(p.search){const q=String(p.search).toLowerCase();a=a.filter(x=>[x.name,x.company,x.mobile].some(v=>String(v).toLowerCase().indexOf(q)>=0));}return{success:true,customers:a};}
function getCustomer_(p){p=p||{};const m=normalizeMobile_(p.mobile||'');const x=readSheetObjects_('Customers').find(r=>String(r.customerId)===String(p.customerId||'')||normalizeMobile_(r.mobile)===m);return x?{success:true,customer:x}:{success:false,error:'Customer not found.'};}
function getUsers_(p){let a=readSheetObjects_('Users');if(p&&p.role)a=a.filter(x=>String(x.role).toLowerCase()===String(p.role).toLowerCase());return{success:true,users:a};}
function getSalesOrders_(p){p=p||{};let a=readSheetObjects_('SalesOrders');if(p.mobile){const m=normalizeMobile_(p.mobile);a=a.filter(x=>normalizeMobile_(x.customerMobile)===m);}if(p.status)a=a.filter(x=>String(x.status).toLowerCase()===String(p.status).toLowerCase());if(p.salespersonId)a=a.filter(x=>String(x.salespersonId)===String(p.salespersonId));if(p.salesOrderNumber)a=a.filter(x=>String(x.salesOrderNumber).toLowerCase()===String(p.salesOrderNumber).toLowerCase());a.sort((x,y)=>new Date(y.createdAt)-new Date(x.createdAt));return{success:true,salesOrders:a};}
function getSalesOrder_(p){p=p||{};const a=readSheetObjects_('SalesOrders');let o=p.salesOrderId?a.find(x=>String(x.salesOrderId)===String(p.salesOrderId)):null;if(!o&&p.salesOrderNumber)o=a.find(x=>String(x.salesOrderNumber).toLowerCase()===String(p.salesOrderNumber).toLowerCase());if(!o)return{success:false,error:'Sales Order not found.'};const items=readSheetObjects_('SalesOrderItems').filter(x=>String(x.salesOrderId)===String(o.salesOrderId));return{success:true,salesOrder:o,items:items};}

function createSalesOrder_(d){d=d||{};if(!Array.isArray(d.items)||!d.items.length)throw new Error('Sales Order cannot be empty.');const mobile=normalizeMobile_(d.customerMobile||(d.customer&&d.customer.mobile)||(d.customer&&d.customer.phone));if(!mobile)throw new Error('Customer mobile number is required.');let customer=findCustomerByMobile_(mobile);if(!customer)customer=createCustomer_({mobile:mobile,name:d.customerName||(d.customer&&d.customer.name)||'Walk-in Customer',company:d.customerCompany||'',email:d.customerEmail||'',address:d.customerAddress||'',notes:d.notes||''});return createOrderRecord_(d,customer,false);}
function createOrderRecord_(d,customer,isDirect){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const products=readSheetObjects_('Products'),orderId=Utilities.getUuid(),number=generateNumber_('salesOrder'),items=[];let subtotal=0,totalQty=0;(d.items||[]).forEach(input=>{const p=products.find(x=>String(x.productId)===String(input.productId));if(!p)throw new Error('Product not found: '+input.productId);const qty=Math.max(1,Number(input.quantity||0)),price=Number(input.unitPrice!==undefined?input.unitPrice:p.unitPrice),disc=Number(input.discount||0),tax=Number(input.tax||0),total=qty*price-disc+tax;items.push([Utilities.getUuid(),orderId,number,p.productId,p.brandId,p.brandName,p.sku,p.model,p.name,qty,price,disc,tax,total,new Date()]);subtotal+=qty*price;totalQty+=qty;});const discount=Number(d.discount||0),tax=Number(d.tax||0),total=subtotal-discount+tax;const order=[orderId,number,customer.customerId,normalizeMobile_(customer.mobile),customer.name,d.salespersonId||'',d.salespersonName||'Salesperson','READY',items.length,totalQty,subtotal,discount,tax,total,d.notes||'',new Date(),new Date()];appendRows_(getSheet_('SalesOrders'),[order]);appendRows_(getSheet_('SalesOrderItems'),items);return{success:true,message:'Sales Order created successfully.',salesOrder:orderToObject_(order),salesOrderId:orderId,salesOrderNumber:number,items:items.map(x=>rowToObject_('SalesOrderItems',x))};}finally{lock.releaseLock();}}
function updateSalesOrder_(d){const s=getSheet_('SalesOrders'),v=s.getDataRange().getValues(),h=v[0],id=h.indexOf('salesOrderId'),st=h.indexOf('status'),up=h.indexOf('updatedAt');for(let i=1;i<v.length;i++)if(String(v[i][id])===String(d.salesOrderId)){if(d.status!==undefined)s.getRange(i+1,st+1).setValue(d.status);s.getRange(i+1,up+1).setValue(new Date());return{success:true,message:'Sales Order updated.'};}throw new Error('Sales Order not found.');}

function getInvoices_(p){p=p||{};let a=readSheetObjects_('Invoices');if(p.mobile){const m=normalizeMobile_(p.mobile);a=a.filter(x=>normalizeMobile_(x.customerMobile)===m);}if(p.invoiceNumber)a=a.filter(x=>String(x.invoiceNumber).toLowerCase()===String(p.invoiceNumber).toLowerCase());a.sort((x,y)=>new Date(y.createdAt)-new Date(x.createdAt));return{success:true,invoices:a};}
function getInvoice_(p){p=p||{};const a=readSheetObjects_('Invoices');let i=p.invoiceId?a.find(x=>String(x.invoiceId)===String(p.invoiceId)):null;if(!i&&p.invoiceNumber)i=a.find(x=>String(x.invoiceNumber).toLowerCase()===String(p.invoiceNumber).toLowerCase());if(!i)throw new Error('Invoice not found.');return{success:true,invoice:i,items:readSheetObjects_('InvoiceItems').filter(x=>String(x.invoiceId)===String(i.invoiceId))};}
function createInvoice_(d){d=d||{};if(!d.salesOrderId)throw new Error('salesOrderId is required.');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const r=getSalesOrder_({salesOrderId:d.salesOrderId});if(!r.success)throw new Error('Sales Order not found.');const o=r.salesOrder;if(String(o.status).toUpperCase()==='INVOICED'){const old=findInvoiceBySalesOrderId_(d.salesOrderId);if(old)return{success:true,alreadyInvoiced:true,message:'Sales Order already has an invoice.',invoice:old,invoiceNumber:old.invoiceNumber};}return writeInvoice_(d,o,r.items||[],true);}finally{lock.releaseLock();}}
function createDirectInvoice_(d){d=d||{};if(!Array.isArray(d.items)||!d.items.length)throw new Error('Invoice cannot be empty.');const mobile=normalizeMobile_(d.customerMobile||(d.customer&&d.customer.mobile)||(d.customer&&d.customer.phone));if(!mobile)throw new Error('Customer mobile number is required.');let customer=findCustomerByMobile_(mobile);if(!customer)customer=createCustomer_({mobile:mobile,name:d.customerName||(d.customer&&d.customer.name)||'Walk-in Customer',company:d.customerCompany||'',email:d.customerEmail||'',address:d.customerAddress||'',notes:d.notes||''});const products=readSheetObjects_('Products'),items=[],orderId='',subtotal=0;let sub=0,qty=0;(d.items||[]).forEach(input=>{const p=products.find(x=>String(x.productId)===String(input.productId));if(!p)throw new Error('Product not found: '+input.productId);const q=Math.max(1,Number(input.quantity||0)),price=Number(input.unitPrice!==undefined?input.unitPrice:p.unitPrice),disc=Number(input.discount||0),tax=Number(input.tax||0),total=q*price-disc+tax;items.push({productId:p.productId,brandId:p.brandId,brandName:p.brandName,sku:p.sku,model:p.model,productName:p.name,quantity:q,unitPrice:price,discount:disc,tax:tax,total:total});sub+=q*price;qty+=q;});const discount=Number(d.discount||0),tax=Number(d.tax||0),total=sub-discount+tax;const invoiceId=Utilities.getUuid(),invoiceNumber=generateNumber_('invoice'),inv=[invoiceId,invoiceNumber,'','',customer.customerId,customer.mobile,customer.name,d.cashierId||'',d.cashierName||'Cashier',d.paymentMethod||'CASH','PAID',items.length,qty,sub,discount,tax,total,d.notes||'',new Date()];const lock=LockService.getScriptLock();lock.waitLock(30000);try{appendRows_(getSheet_('Invoices'),[inv]);const rows=items.map(x=>[Utilities.getUuid(),invoiceId,invoiceNumber,'',x.productId,x.brandId,x.brandName,x.sku,x.model,x.productName,x.quantity,x.unitPrice,x.discount,x.tax,x.total,new Date()]);appendRows_(getSheet_('InvoiceItems'),rows);reduceStock_(items);return{success:true,message:'Invoice created successfully.',invoiceId:invoiceId,invoiceNumber:invoiceNumber,invoice:invoiceToObject_(inv),items:rows.map(x=>rowToObject_('InvoiceItems',x))};}finally{lock.releaseLock();}}
function writeInvoice_(d,o,orderItems,fromOrder){const invoiceId=Utilities.getUuid(),invoiceNumber=generateNumber_('invoice'),inv=[invoiceId,invoiceNumber,o.salesOrderId,o.salesOrderNumber,o.customerId,o.customerMobile,o.customerName,d.cashierId||'',d.cashierName||'Cashier',d.paymentMethod||'CASH','PAID',o.itemCount,o.totalQuantity,o.subtotal,o.discount,o.tax,o.total,d.notes||'',new Date()];appendRows_(getSheet_('Invoices'),[inv]);const rows=orderItems.map(x=>[Utilities.getUuid(),invoiceId,invoiceNumber,o.salesOrderId,x.productId,x.brandId,x.brandName,x.sku,x.model,x.productName,x.quantity,x.unitPrice,x.discount,x.tax,x.total,new Date()]);appendRows_(getSheet_('InvoiceItems'),rows);reduceStock_(orderItems);if(fromOrder)updateSalesOrder_({salesOrderId:o.salesOrderId,status:'INVOICED'});return{success:true,message:'Invoice created successfully.',invoiceId:invoiceId,invoiceNumber:invoiceNumber,salesOrderNumber:o.salesOrderNumber||'',paymentMethod:d.paymentMethod||'CASH',invoice:invoiceToObject_(inv),items:rows.map(x=>rowToObject_('InvoiceItems',x))};}
function reduceStock_(items){const s=getSheet_('Products'),v=s.getDataRange().getValues(),h=v[0],pi=h.indexOf('productId'),si=h.indexOf('stock');(items||[]).forEach(item=>{for(let i=1;i<v.length;i++)if(String(v[i][pi])===String(item.productId)){s.getRange(i+1,si+1).setValue(Math.max(0,Number(v[i][si]||0)-Number(item.quantity)));break;}});}

function getDashboard_(){const orders=readSheetObjects_('SalesOrders'),invoices=readSheetObjects_('Invoices'),products=readSheetObjects_('Products'),customers=readSheetObjects_('Customers');let salesTotal=0;invoices.forEach(i=>salesTotal+=Number(i.total||0));return{success:true,stats:{products:products.length,customers:customers.length,salesOrders:orders.length,readySalesOrders:orders.filter(o=>String(o.status).toUpperCase()==='READY').length,invoicedSalesOrders:orders.filter(o=>String(o.status).toUpperCase()==='INVOICED').length,invoices:invoices.length,salesTotal:salesTotal},recentSalesOrders:orders.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).slice(0,20)};}
function createCustomer_(d){const row=['CUS-'+Utilities.getUuid().substring(0,8).toUpperCase(),normalizeMobile_(d.mobile),d.name||'Walk-in Customer',d.company||'',d.email||'',d.address||'',d.notes||'',new Date()];appendRows_(getSheet_('Customers'),[row]);return customerToObject_(row);}
function findCustomerByMobile_(m){const n=normalizeMobile_(m);return readSheetObjects_('Customers').find(c=>normalizeMobile_(c.mobile)===n)||null;}
function findInvoiceBySalesOrderId_(id){return readSheetObjects_('Invoices').find(i=>String(i.salesOrderId)===String(id))||null;}
function generateNumber_(type){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const p=PropertiesService.getScriptProperties();const key=type==='invoice'?'LAST_INVOICE_NUMBER':'LAST_SALES_ORDER_NUMBER';const prefix=getSetting_(type==='invoice'?'invoicePrefix':'salesOrderPrefix')||(type==='invoice'?'INV':'SO');let n=Number(p.getProperty(key)||'0')+1;p.setProperty(key,String(n));return prefix+'-'+new Date().getFullYear()+'-'+String(n).padStart(6,'0');}finally{lock.releaseLock();}}
function getSetting_(key){const x=readSheetObjects_('Settings').find(r=>String(r.key)===String(key));return x?x.value:null;}
function resetDemoData_(){const ss=getDatabase_();['Products','Customers','Users','SalesOrders','SalesOrderItems','Invoices','InvoiceItems'].forEach(n=>{const s=ss.getSheetByName(n);if(s&&s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).clearContent();});PropertiesService.getScriptProperties().deleteProperty('LAST_INVOICE_NUMBER');PropertiesService.getScriptProperties().deleteProperty('LAST_SALES_ORDER_NUMBER');seedDemoData_(ss);return{success:true,message:'Demo data has been reset.',spreadsheetId:ss.getId(),spreadsheetUrl:ss.getUrl()};}
function getDatabase_(){const p=PropertiesService.getScriptProperties();let id=p.getProperty(CONFIG.spreadsheetProperty);if(!id){id=setupDatabase_().spreadsheetId;}try{return SpreadsheetApp.openById(id);}catch(_){p.deleteProperty(CONFIG.spreadsheetProperty);return SpreadsheetApp.openById(setupDatabase_().spreadsheetId);}}
function getSheet_(n){const s=getDatabase_().getSheetByName(n);if(!s)throw new Error('Sheet not found: '+n);return s;}
function readSheetObjects_(n){const s=getSheet_(n),v=s.getDataRange().getValues();if(v.length<=1)return[];const h=v[0];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>{const o={};h.forEach((k,i)=>o[k]=normalizeValue_(r[i]));return o;});}
function appendRows_(s,rows){if(!rows||!rows.length)return;s.getRange(s.getLastRow()+1,1,rows.length,rows[0].length).setValues(rows);}
function normalizeValue_(v){return Object.prototype.toString.call(v)==='[object Date]'?v.toISOString():v;}
function normalizeMobile_(v){return String(v||'').replace(/[\s\-()]/g,'');}
function rowToObject_(n,row){const o={};SCHEMAS[n].forEach((h,i)=>o[h]=normalizeValue_(row[i]));return o;}
function orderToObject_(r){return rowToObject_('SalesOrders',r);}
function invoiceToObject_(r){return rowToObject_('Invoices',r);}
function customerToObject_(r){return rowToObject_('Customers',r);}
function jsonResponse_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}
