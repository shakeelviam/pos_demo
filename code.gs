function doGet(e){try{const p=e&&e.parameter?e.parameter:{};return jsonResponse_(routeRequest_('GET',p.action||'health',p,null));}catch(err){return jsonResponse_({success:false,error:err.message,stack:err.stack});}}
function doPost(e){try{const p=e&&e.parameter?e.parameter:{};let body={};if(e&&e.postData&&e.postData.contents){try{body=JSON.parse(e.postData.contents);}catch(_){}}return jsonResponse_(routeRequest_('POST',body.action||p.action||'',body,p));}catch(err){return jsonResponse_({success:false,error:err.message,stack:err.stack});}}
function routeRequest_(method,action,data,params){action=String(action||'').trim();switch(action){case'health':return apiHealth_();case'setup':return setupDatabase_();case'resetDemo':return resetDemoData_();case'brands':return getBrands_();case'products':return getProducts_(data);case'product':return getProduct_(data);case'customers':return searchCustomers_(data);case'customer':return getCustomer_(data);case'users':return getUsers_(data);case'salesOrders':return getSalesOrders_(data);case'salesOrder':return getSalesOrder_(data);case'createSalesOrder':return createSalesOrder_(data);case'updateSalesOrder':return updateSalesOrder_(data);case'invoices':return getInvoices_(data);case'invoice':return getInvoice_(data);case'createInvoice':return createInvoice_(data);case'createDirectInvoice':return createDirectInvoice_(data);case'dashboard':return getDashboard_();default:return{success:false,error:'Unknown action: '+action};}}

function setupDatabase_(){const props=PropertiesService.getScriptProperties();let id=props.getProperty(CONFIG.spreadsheetProperty),ss=null;if(id){try{ss=SpreadsheetApp.openById(id);}catch(_){}}if(!ss){ss=SpreadsheetApp.create(APP_NAME+' - Demo Database');id=ss.getId();props.setProperty(CONFIG.spreadsheetProperty,id);}Object.keys(SCHEMAS).forEach(n=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);initializeSheet_(s,SCHEMAS[n]);});const s1=ss.getSheetByName('Sheet1');if(s1&&ss.getSheets().length>1&&s1.getLastRow()===0)ss.deleteSheet(s1);seedDemoData_(ss);return{success:true,message:'Database is ready.',spreadsheetId:ss.getId(),spreadsheetUrl:ss.getUrl(),sheets:Object.keys(SCHEMAS)};}
function initializeSheet_(sheet,headers){if(sheet.getLastRow()===0){sheet.getRange(1,1,1,headers.length).setValues([headers]);formatHeader_(sheet,headers.length);return;}const existing=sheet.getRange(1,1,1,Math.max(sheet.getLastColumn(),headers.length)).getValues()[0];if(headers.some((h,i)=>existing[i]!==h)){sheet.getRange(1,1,1,headers.length).setValues([headers]);formatHeader_(sheet,headers.length);}}
function formatHeader_(sheet,n){sheet.getRange(1,1,1,n).setFontWeight('bold');sheet.setFrozenRows(1);for(let i=1;i<=n;i++)sheet.autoResizeColumn(i);}
function seedDemoData_(ss){seedBrands_(ss);seedProducts_(ss);seedCustomers_(ss);seedUsers_(ss);seedSettings_(ss);}

